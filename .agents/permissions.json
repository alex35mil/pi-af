{
    "deny": [
        "read(*mise.local.toml)"
    ],
    "allow": [
        "bash(npm test *)",
        "bash(npx tsx --test *)",
        "bash(npx tsc --noEmit)",
        "bash(npx oxfmt --check *)",
        "mcp(github, hint: readOnly)",
        "mcp(github, projects_write)",
        "mcp(github, issue_write)",
        "mcp(github, add_issue_comment)",
        "mcp(github, update_issue_comment)"
    ]
}
