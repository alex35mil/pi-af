{
    "meta": {
        "name": "pi-agent",
        "description": "Pi on the macOS host, confined to one worker checkout, sharing the host Pi and Claude Code setup"
    },
    "extends": "mise-dev",
    "groups": { "include": ["git_config"] },
    "workdir": { "access": "readwrite" },
    "filesystem": {
        "allow": ["$HOME/.config/pi/agent", "$HOME/.config/claude", "$HOME/Library/Keychains"],
        "read": ["$HOME/path/to/dotfiles/.config/pi/agent", "$HOME/path/to/pi-af"],
        "read_file": ["$HOME/.ssh/config", "$HOME/.ssh/known_hosts"],
        "unix_socket": ["$SSH_AUTH_SOCK"],
        "bypass_protection": ["$HOME/Library/Keychains", "$HOME/.ssh/config", "$HOME/.ssh/known_hosts"]
    },
    "network": { "network_profile": null, "open_port": [0] },
    "environment": { "set_vars": { "PI_AF_RUNTIME": "sandbox" } }
}
